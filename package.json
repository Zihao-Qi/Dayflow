{
  "name": "dayflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "check": "npm run prisma:generate && npm run test:architecture && npm run typecheck && npm run test:unit && npm run test:backup && npm run test:migrations && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node --import tsx --test tests/architecture.test.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:prepare": "node --import tsx scripts/prepare-e2e-db.ts",
    "test:e2e:server": "next dev -H 127.0.0.1 -p 3100",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:unit": "TZ=America/Chicago node --import tsx --test tests/unit/**/*.test.ts",
    "test:backup": "TZ=America/Chicago node --import tsx --test tests/integration/*.test.ts",
    "test:migrations": "tsx scripts/test-migrations.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "evidence:reconcile": "tsx scripts/reconcile-evidence.ts",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:backup": "node --import tsx scripts/backup-database.ts",
    "db:restore": "node --import tsx scripts/restore-database.ts",
    "db:init": "prisma migrate deploy",
    "prisma:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:setup": "npm run db:migrate && npm run prisma:seed",
    "db:reset-demo": "DAYFLOW_SEED_RESET=1 npm run prisma:seed",
    "pwa:icons": "node --import tsx scripts/generate-pwa-icons.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "0.475.0",
    "next": "15.5.21",
    "prisma": "6.19.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "26.4.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "deepmerge-ts": "^8.0.0"
  }
}
