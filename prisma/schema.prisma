generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectDurationUnit {
  DAYS
  WEEKS
}

enum FocusSessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
}

enum FocusSessionKind {
  FOCUS
  BREAK
}

model Project {
  id                  String          @id @default(cuid())
  name                String
  desiredOutcome      String          @default("")
  targetDate          DateTime?
  targetDurationValue Int?
  targetDurationUnit  ProjectDurationUnit?
  weeklyMinutesBudget Int?
  status              ProjectStatus   @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  phases              ProjectPhase[]
  tasks               Task[]
  notes               Note[]
  materials           Material[]
  activities          ActivityEntry[]
  focusSessions       FocusSession[]

  @@index([status])
}

model ProjectPhase {
  id        String   @id @default(cuid())
  projectId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, sortOrder])
}

model Task {
  id              String          @id @default(cuid())
  title           String
  date            DateTime?
  status          TaskStatus      @default(TODO)
  priority        Priority        @default(MEDIUM)
  urgentScore     Int             @default(2)
  importanceScore Int             @default(3)
  deadline        DateTime?
  estimateMinutes Int             @default(30)
  actualMinutes   Int             @default(0)
  sortOrder       Int             @default(0)
  focusQueuePosition Int?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  projectId       String?
  phaseId         String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phase           ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  notes           Note[]
  materials       Material[]
  timeBlocks      TimeBlock[]
  activities      ActivityEntry[]
  focusSessions   FocusSession[]
  scheduleChanges TaskScheduleChange[]

  @@index([date])
  @@index([focusQueuePosition])
  @@index([projectId])
  @@index([phaseId])
}

model Note {
  id        String     @id @default(cuid())
  content   String
  tags      String     @default("[]")
  date      DateTime
  taskId    String?
  projectId String?
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  materials Material[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([projectId])
}

model DiaryEntry {
  id         String   @id @default(cuid())
  date       DateTime @unique
  content    String   @default("")
  reflection String   @default("")
  mood       Int      @default(3)
  energy     Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Material {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String   @default("website")
  notes     String   @default("")
  taskId    String?
  noteId    String?
  projectId String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model TimeBlock {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  title     String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityEntry {
  id              String   @id @default(cuid())
  startedAt       DateTime
  durationMinutes Int
  category        String
  note            String
  taskId          String?
  projectId       String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startedAt])
  @@index([taskId])
  @@index([projectId])
}

model FocusSession {
  id                      String             @id @default(cuid())
  kind                    FocusSessionKind   @default(FOCUS)
  plannedMinutes          Int
  actualMinutes           Int                @default(0)
  label                   String             @default("")
  startedAt               DateTime           @default(now())
  pausedAt                DateTime?
  accumulatedPauseSeconds Int                @default(0)
  status                  FocusSessionStatus @default(RUNNING)
  completedAt             DateTime?
  needsRecord             Boolean            @default(false)
  recordedAt              DateTime?
  completionNote          String?
  completionCategory      String?
  taskId                  String?
  projectId               String?
  task                    Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project                 Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([status])
  @@index([completedAt])
  @@index([taskId])
  @@index([projectId])
}

model TaskScheduleChange {
  id           String   @id @default(cuid())
  taskId       String
  previousDate DateTime?
  nextDate     DateTime?
  source       String   @default("manual")
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
